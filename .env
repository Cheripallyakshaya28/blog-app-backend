# LOCAL SETTINGS - edit DB_PASSWORD to your MySQL root password, then run:  mvnw spring-boot:run
DB_URL=jdbc:h2:mem:blogapp;MODE=MySQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DB_USERNAME=sa
DB_PASSWORD=

SECRET_KEY=local-dev-secret-change-me-before-deploying
PORT=4000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:5173,https://blog-app-ivdh.vercel.app

# Admin login created automatically on first start
ADMIN_EMAIL=admin@mail.com
ADMIN_PASSWORD=admin123

# Local http://localhost works with these. For deployment (https) use COOKIE_SECURE=true and COOKIE_SAME_SITE=None
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
